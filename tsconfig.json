{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM"],
    "strict": false,
    "noImplicitAny": false,
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": false
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts", "test/**/*.ts", "ui/**/*.ts", "types/**/*.d.ts"]
}
